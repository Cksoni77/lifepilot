DATABASE_URL=jdbc:postgresql://localhost:5432/lifepilot
DATABASE_USERNAME=lifepilot
DATABASE_PASSWORD=replace-with-a-random-local-password
JWT_SECRET=replace-with-base64-encoded-32-random-bytes
