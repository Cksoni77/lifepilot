OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=20
PORT=8080
RECOMMENDATION_PRIORITY_WEIGHT=0.30
RECOMMENDATION_URGENCY_WEIGHT=0.30
RECOMMENDATION_DEADLINE_WEIGHT=0.20
